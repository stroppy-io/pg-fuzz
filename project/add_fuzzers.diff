 	EventTriggerOnLogin();
 
+#ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
+	fuzzer_first_run = false;
+	}
+#endif							/* FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION */
+
 	/*
 	 * POSTGRES main processing loop begins here
 	 *
diff --git a/src/backend/utils/error/elog.c b/src/backend/utils/error/elog.c
--- a/src/backend/utils/error/elog.c	2025-11-10 22:53:58.000000000 +0100
+++ b/src/backend/utils/error/elog.c	2026-08-06 19:12:55.658205032 +0200
@@ -543,6 +543,31 @@
 	}

 	/* Emit the message to the right places */
-	EmitErrorReport();
+#ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
+	/*
+	 * Suppressed for fuzzing only, and only BELOW FATAL.  A fuzz target
+	 * rejects the overwhelming majority of its inputs, and reporting every
+	 * rejection costs more than the run does.
+	 *
+	 * The elevel test is not a refinement, it is the whole correctness of
+	 * this hunk.  errfinish() reaches this line only for NON-ERROR levels --
+	 * elevel == ERROR returns earlier through PG_RE_THROW() -- so an
+	 * unconditional suppression here covers WARNING/NOTICE/LOG as intended
+	 * AND FATAL/PANIC, which was never intended.  The consequence is that a
+	 * PANIC reached libFuzzer with zero PostgreSQL text: no message, no
+	 * statement, triage starting from a bare stack.  Measured on 2026-08-16
+	 * with a deliberate FATAL that printed nothing at all.
+	 *
+	 * The #ifdef is load-bearing too.  Without it this also silences the
+	 * *uninstrumented* server built from the same tree -- the one in
+	 * tmp_install that initdb, pg_ctl and psql use -- so a real postmaster
+	 * logs nothing at all, backends die without saying why, and every
+	 * attempt to use that server as an oracle is blind.
+	 */
+	if (edata->elevel >= FATAL)
+		EmitErrorReport();
+#else
+	EmitErrorReport();
+#endif
 
 	/* Now free up subsidiary data attached to stack entry, and release it */
 	FreeErrorDataContents(edata);
