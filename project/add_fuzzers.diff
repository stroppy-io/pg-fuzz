@@ -2822,5 +2826,33 @@
 }
 
+#ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
+/*
+ * Reset the transaction-command bookkeeping, for a fuzz harness that drives
+ * exec_simple_query() directly instead of going round PostgresMain's loop.
+ *
+ * xact_started is file-static, and PostgresMain clears it in its sigsetjmp
+ * recovery block with the comment "We don't have a transaction command open
+ * anymore" -- right after AbortCurrentTransaction().  A harness driving
+ * PostgresMain's own machinery cannot reach it, so its error path would leave
+ * the flag true with no transaction open, and the next start_xact_command()
+ * would conclude one was already running and start none.
+ *
+ * Scope, stated precisely because it was once overstated: this matters only
+ * for a harness that actually calls postgres.c's static start_xact_command()
+ * and finish_xact_command() -- protocol_fuzzer, which drives PostgresMain.
+ * simple_query_fuzzer has its OWN exec_simple_query() and never touches those,
+ * so the flag cannot go stale there and clearing it changes nothing.  It was
+ * briefly blamed for an Assert(ActiveSnapshotSet()) in that target on
+ * 2026-08-15; the real cause was the harness never pushing a snapshot at all.
+ * The export is correct on its own merits and costs nothing.
+ */
+void
+pgfuzz_reset_xact_started(void)
+{
+	xact_started = false;
+}
+#endif
+
 static void
 finish_xact_command(void)
 {
